# this is part of RuneAudio
# pcm output device to pipe bluealsa-aplay output to an owntone fifo pipe
pcm.owntonebtfifo {
 type plug
 slave {
  # type rate # by not specifying 'type rate' the rate converter will only be used when required
  pcm "owntonebtFIFO"
  format S16_LE # owntone format
  rate 44100 # owntone rate
  channels 2 # owntone channels
 }
 hint {
  show {
   @func refer
   name defaults.namehint.extended
  }
  description "pcm output device to pipe bluealsa-aplay output to an owntone fifo pipe with rate conversion (S16_LE, 44.1kHz)"
 }
}
pcm.owntonebtFIFO {
 type file
 slave.pcm null
 file "/run/owntone/music/pipe_bt.fifo" # the bt owntone fifo file name
 format "raw"
 hint {
  show {
   @func refer
   name defaults.namehint.extended
  }
  description "pcm output device to pipe bluealsa-aplay output to an owntone fifo pipe without rate conversion"
 }
}
