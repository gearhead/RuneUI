# this is part of RuneAudio
# pcm output device to pipe spotify connect output to an owntone fifo pipe
pcm.owntonescfifo {
 type plug
 slave.pcm {
  type rate
  slave.pcm {
   type file
   slave.pcm null
   file "/run/owntone/music/pipe_sc.fifo" # the sc owntone fifo file name
   format "raw"
  }
  format S16_LE # owntone format
  rate 44100 # owntone rate
 }
 hint {
  show {
   @func refer
   name defaults.namehint.extended
  }
  description "pcm output device to pipe spotify connect output to an owntone fifo pipe"
 }
}
