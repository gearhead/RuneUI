#!/bin/bash
# Fix systemd bug: ensure per-link DNSSEC matches global setting
# Also handles time-sync issue on Pi without RTC when DNSSEC is enabled

if [ "$2" = "up" ]; then
    # Get the global DNSSEC setting
    global_dnssec=$(/usr/bin/resolvectl status | grep "^Global$" -A 10 | grep "DNSSEC=" | head -1)
    global_mode=$(echo "$global_dnssec" | grep -o "DNSSEC=[^ ]*" | cut -d'=' -f2 | cut -d'/' -f1)
    
    if [ -n "$global_mode" ]; then
        # Check if time is already synced
        time_synced=false
        if timedatectl status | grep -q "System clock synchronized: yes"; then
            time_synced=true
        fi
        
        # If DNSSEC is enabled but time not synced, temporarily disable it
        if [ "$global_mode" = "yes" ] || [ "$global_mode" = "allow-downgrade" ]; then
            if [ "$time_synced" = "false" ]; then
                # Temporarily disable for time sync
                /usr/bin/resolvectl dnssec "$1" no 2>/dev/null
                
                # Background process: wait for time sync, then re-enable
                (
                    timeout=60
                    while [ $timeout -gt 0 ]; do
                        if timedatectl status | grep -q "System clock synchronized: yes"; then
                            sleep 2
                            /usr/bin/resolvectl dnssec "$1" "$global_mode" 2>/dev/null
                            break
                        fi
                        sleep 1
                        timeout=$((timeout - 1))
                    done
                ) &
            else
                # Time already synced, just ensure link matches global
                sleep 0.5
                link_dnssec=$(/usr/bin/resolvectl status "$1" | grep "DNSSEC=" | head -1)
                link_mode=$(echo "$link_dnssec" | grep -o "DNSSEC=[^ ]*" | cut -d'=' -f2 | cut -d'/' -f1)
                
                if [ "$link_mode" != "$global_mode" ]; then
                    /usr/bin/resolvectl dnssec "$1" "$global_mode" 2>/dev/null
                fi
            fi
        else
            # DNSSEC is disabled, just ensure link matches
            sleep 0.5
            link_dnssec=$(/usr/bin/resolvectl status "$1" | grep "DNSSEC=" | head -1)
            link_mode=$(echo "$link_dnssec" | grep -o "DNSSEC=[^ ]*" | cut -d'=' -f2 | cut -d'/' -f1)
            
            if [ "$link_mode" != "$global_mode" ]; then
                /usr/bin/resolvectl dnssec "$1" "$global_mode" 2>/dev/null
            fi
        fi
    fi
fi
