[Unit]
Description = Fix Wi-Fi nics which fail to acquire a queue
# some Wi-Fi ddevices and dongles fail to acquire a queue so when busy all requests are dropped
# this workaround will fix the problem
# DefaultDependencies=no
After=network.target

[Service]
Type=oneshot
# this is important, without it this routine will restart with rune_SY_wrk
RemainAfterExit=yes
ExecStart=/srv/http/command/fix_wlanx.sh

[Install]
# WantedBy=getty.target # removed for vc4 implementation
# WantedBy=multi-user.target # removed, Wi-Fi only configuration will wait for completion in boot sequence
WantedBy=rune_SY_wrk.service
